{
  "scanSettings": {
    "configMode": "LOCAL",
    "enableIaC": "true",
    "enableLicenseViolations": false,
    "baseBranches": ["main"]
  },
  "checkRunSettings": {
    "vulnerableCheckRunConclusionLevel": "failure",
    "displayMode": "baseline",
    "useMendCheckNames": true
  },
  "issueSettings": {
    "minSeverityLevel": "LOW",
    "issueType": "DEPENDENCY"
  },
  "issueSettingsSAST": {
    "issueType": "repo",
    "minSeverityLevel": "high"
  },
  "remediateSettings": {
    "workflowRules": {
      "enabled": true
    },
    "transitiveRemediation": true,
    "enableRenovate": true,
    "extends": ["config:base"]
  }
}