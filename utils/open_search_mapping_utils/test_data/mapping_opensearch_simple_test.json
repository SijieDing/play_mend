{
    ".ql-datasources": {
        "mappings": {
            "dynamic": "false",
            "properties": {
                "connector": {
                    "type": "keyword"
                },
                "name": {
                    "type": "text",
                    "fields": {
                        "keyword": {
                            "type": "keyword"
                        }
                    }
                },
                "resultIndex": {
                    "type": "keyword"
                },
                "status": {
                    "type": "keyword"
                }
            }
        }
    },
    "unite-logs-000031": {
        "mappings": {
