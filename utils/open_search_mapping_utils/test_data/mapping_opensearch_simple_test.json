                                                    }
                                                },
                                                "record_type": {
                                                    "type": "keyword"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "severityNumber": {
                    "type": "long"
                }
            }
        }
    },
